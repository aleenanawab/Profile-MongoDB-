# ==============================================================================
# Avtive Platform - Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for local development. Never commit .env or .env.local!
# All sensitive credentials and production secrets should be managed securely in Vercel.

# ------------------------------------------------------------------------------
# 1. MongoDB Atlas Connection
# ------------------------------------------------------------------------------
# Primary MongoDB connection string (SRV or standard format)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=avtive_fresh

# Optional MongoDB credentials if not embedded in the URI:
# MONGODB_USERNAME=your_username # legacy alias (still supported)
# MONGODB_PASSWORD=your_password # legacy alias (still supported)

# ------------------------------------------------------------------------------
# 2. Application Session & Authentication
# ------------------------------------------------------------------------------
# 32+ character random secret keys for session cookies and JWT signing
SESSION_SECRET=your-random-32-byte-secret-key-min-32-chars
JWT_SECRET=your-random-32-byte-secret-key-min-32-chars

# Canonical application public base URL (e.g. http://localhost:3000 or https://avtive.com)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Legacy URL fallback:
# NEXTAUTH_URL=http://localhost:3000 # legacy alias (still supported)

# ------------------------------------------------------------------------------
# 3. Google OAuth 2.0 Credentials (Optional for Google Sign-In)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-yourClientSecret

# Legacy Google OAuth fallbacks:
# AUTH_GOOGLE_ID=your-client-id.apps.googleusercontent.com # legacy alias (still supported)
# AUTH_GOOGLE_SECRET=GOCSPX-yourClientSecret # legacy alias (still supported)

# ------------------------------------------------------------------------------
# 4. Cloudinary Media Storage
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Legacy Cloudinary fallbacks:
# CLOUDINARY_NAME=your-cloud-name # legacy alias (still supported)
# CLOUDINARY_KEY=your-cloudinary-api-key # legacy alias (still supported)
# CLOUDINARY_SECRET=your-cloudinary-api-secret # legacy alias (still supported)
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name # legacy alias (still supported)

# ------------------------------------------------------------------------------
# 5. Email Service: Option A (SMTP / Gmail)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM="Avtive Security" <no-reply@example.com>

# Legacy SMTP fallbacks:
# SMTP_PASSWORD=your-16-char-app-password # legacy alias (still supported)
# SMTP_SECURE=false # legacy alias (still supported: 'true' or 'false', defaults to true if port is 465)

# ------------------------------------------------------------------------------
# 6. Email Service: Option B (Resend API)
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM="Avtive Security" <no-reply@yourdomain.com>