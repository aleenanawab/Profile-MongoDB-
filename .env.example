# MongoDB Atlas Connection
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=avtive_fresh

# Application Session & Authentication
SESSION_SECRET=your-random-32-byte-secret-key-min-32-chars
JWT_SECRET=your-random-32-byte-secret-key-min-32-chars
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google OAuth 2.0 Credentials (Optional for Google Sign-In)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-yourClientSecret

# Cloudinary Media Storage
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Email Service: Option A (SMTP / Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM="Avtive Security" <no-reply@example.com>

# Email Service: Option B (Resend API)
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM=Avtive Security <no-reply@yourdomain.com>
